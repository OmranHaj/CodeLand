generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                     String                @id @default(uuid())
  email                                  String                @unique
  name                                   String?
  password                               String?
  googleId                               String?               @unique
  githubId                               String?               @unique
  discordId                              String?               @unique
  tokenVersion                           Int                   @default(0)
  avatar                                 String?
  role                                   Role                  @default(PARENT)
  parentCode                             String?               @unique
  parentId                               String?
  streakDays                             Int                   @default(0)
  lastStreakAt                           DateTime?
  // Float because arena hint penalties award quarter XP (e.g. 25 * 0.75 = 18.75).
  totalXp                                Float                 @default(0)
  lastActiveAt                           DateTime              @default(now())
  createdAt                              DateTime              @default(now())
  updatedAt                              DateTime              @updatedAt
  ChallengeSubmission                    ChallengeSubmission[]
  dailyActivities                        DailyActivity[]
  LearningProgress                       LearningProgress[]
  ParentCheer_ParentCheer_childIdToUser  ParentCheer[]         @relation("ParentCheer_childIdToUser")
  ParentCheer_ParentCheer_parentIdToUser ParentCheer[]         @relation("ParentCheer_parentIdToUser")
  submissions                            ProjectSubmission[]
  codeSubmissions                        CodeSubmission[]
  // SetNull: deleting an organization only unlinks its students; their accounts and progress stay.
  parent                                 User?                 @relation("ParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children                               User[]                @relation("ParentChildren")
  UserAchievement                        UserAchievement[]
  UserProfile                            UserProfile?
  passwordResetTokens                    PasswordResetToken[]

  status                                 UserStatus            @default(ACTIVE)
  suspendedAt                            DateTime?
  suspendReason                          String?
  adminAuditLogs                         AdminAuditLog[]       @relation("AdminAuditActor")
  targetAuditLogs                        AdminAuditLog[]       @relation("AdminAuditTarget")
  arenaProblemsCreated                   ArenaProblem[]        @relation("ArenaProblemAuthor")
  arenaAttempts                          ArenaProblemAttempt[]
  arenaContestsCreated                   ArenaContest[]        @relation("ArenaContestAuthor")
  arenaRegistrations                     ArenaRegistration[]
  arenaMedals                            ArenaMedal[]
  // Organization (role PARENT) membership requests sent by students / received by organizations.
  orgJoinRequestsSent                    OrganizationJoinRequest[] @relation("JoinRequestStudent")
  orgJoinRequestsReceived                OrganizationJoinRequest[] @relation("JoinRequestOrganization")

  @@index([parentId])
  @@index([role, status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model DailyActivity {
  id                  String   @id @default(uuid())
  userId              String
  date                DateTime
  durationMinutes     Int      @default(0)
  lessonsCompleted    Int      @default(0)
  challengesCompleted Int      @default(0)
  xpEarned            Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model ProjectSubmission {
  id           String   @id @default(uuid())
  userId       String
  levelId      String
  sourceCode   String
  reviewChecks Json
  score        Int      @default(0)
  passed       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, levelId])
}

model Achievement {
  id              String            @id @default(uuid())
  title           String
  description     String
  badgeUrl        String?
  criteria        String?
  xpReward        Int               @default(50)
  createdAt       DateTime          @default(now())
  UserAchievement UserAchievement[]
}

model ChallengeSubmission {
  id            String   @id @default(uuid())
  userId        String
  challengeId   String
  submittedCode String
  passed        Boolean  @default(false)
  xpEarned      Int      @default(0)
  submittedAt   DateTime @default(now())
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, challengeId])
}

model LearningProgress {
  id                    String         @id @default(uuid())
  userId                String
  trackId               String
  levelId               String
  completedLessonIds    Json           @default("[]")
  completedChallengeIds Json           @default("[]")
  xp                    Int            @default(0)
  progressPercent       Float          @default(0)
  status                ProgressStatus @default(LOCKED)
  lastAccessedAt        DateTime       @default(now())
  createdAt             DateTime       @default(now())
  updatedAt             DateTime
  User                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId, trackId])
}

model ParentCheer {
  id                              String    @id @default(uuid())
  parentId                        String
  childId                         String
  message                         String
  readAt                          DateTime?
  createdAt                       DateTime  @default(now())
  User_ParentCheer_childIdToUser  User      @relation("ParentCheer_childIdToUser", fields: [childId], references: [id], onDelete: Cascade)
  User_ParentCheer_parentIdToUser User      @relation("ParentCheer_parentIdToUser", fields: [parentId], references: [id], onDelete: Cascade)

  @@index([childId, readAt])
  @@index([parentId])
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  Achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  User          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  avatarTheme     String   @default("violet")
  dailyGoal       Int      @default(3)
  weeklyGoalHours Float    @default(6.0)
  soundEffects    Boolean  @default(true)
  reducedMotion   Boolean  @default(false)
  fontSize        String   @default("md")
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  User            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  PARENT
  CHILD
  ADMIN
}

enum OrganizationJoinStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ProgressStatus {
  LOCKED
  IN_PROGRESS
  COMPLETED
}

enum SubmissionStatus {
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  adminId      String
  targetUserId String?
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())

  admin      User  @relation("AdminAuditActor", fields: [adminId], references: [id], onDelete: Cascade)
  targetUser User? @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt])
}

model Track {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  icon        String?
  themeColor  String?
  order       Int      @default(0)
  levels      Level[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Level {
  id               String       @id @default(uuid())
  slug             String       @unique
  title            String
  subtitle         String?
  description      String?
  version          Int          @default(1)
  status           String       @default("published")
  accent           String?
  estimatedMinutes Int          @default(60)
  order            Int          @default(0)
  xpReward         Int          @default(100)
  trackId          String
  track            Track        @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lessons          Lesson[]
  challenges       Challenge[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([trackId])
}

model Lesson {
  id               String   @id @default(uuid())
  slug             String
  order            Int      @default(0)
  title            String
  subtitle         String?
  description      String?
  difficulty       String   @default("beginner")
  xp               Int      @default(50)
  estimatedMinutes Int      @default(10)
  status           String   @default("published")
  blocks           Json     @default("[]")
  levelId          String
  level            Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([levelId, slug])
  @@index([levelId])
}

model Challenge {
  id               String   @id @default(uuid())
  slug             String?
  order            Int      @default(0)
  title            String
  subtitle         String?
  description      String?
  difficulty       String   @default("beginner")
  xp               Int      @default(100)
  estimatedMinutes Int      @default(15)
  status           String   @default("published")
  tasks            Json     @default("[]")
  starterCode      String?          @db.Text
  solutionCode     String?          @db.Text
  hints            Json             @default("[]")
  language         String           @default("cpp")
  timeLimit        Float            @default(2.0)
  memoryLimit      Int              @default(128)
  levelId          String
  level            Level            @relation(fields: [levelId], references: [id], onDelete: Cascade)
  testCases        TestCase[]
  codeSubmissions  CodeSubmission[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([levelId])
}

model TestCase {
  id             String    @id @default(uuid())
  challengeId    String
  input          String    @db.Text
  expectedOutput String    @db.Text
  isHidden       Boolean   @default(false)
  order          Int       @default(0)
  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model CodeSubmission {
  id            String           @id @default(uuid())
  userId        String
  challengeId   String
  code          String           @db.Text
  language      String           @default("cpp")
  status        SubmissionStatus
  passedTests   Int              @default(0)
  totalTests    Int              @default(0)
  executionTime Float?
  errorMessage  String?          @db.Text
  createdAt     DateTime         @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId, challengeId])
  @@index([challengeId])
}


enum ArenaProblemStatus {
  DRAFT
  PUBLISHED
}

// A Sunday Arena problem produced by ai/generate_contest.py. Every field the
// generator returns has a column here; rawOutput keeps the untouched payload
// (minus the image bytes, which live in imageData).
model ArenaProblem {
  id                       String             @id @default(uuid())
  status                   ArenaProblemStatus @default(DRAFT)
  xp                       Int
  title                    String
  arabicTitle              String?
  difficulty               String
  difficultyIndex          Int                @default(0)
  difficultyColor          String?
  statement                String             @db.Text
  taskDescription          String?            @db.Text
  inputSpec                String             @db.Text
  outputSpec               String             @db.Text
  constraints              Json               @default("[]")
  examples                 Json               @default("[]")
  note                     String?            @db.Text
  hint                     String             @db.Text
  timeLimit                String?
  memoryLimit              String?
  starterCode              Json               @default("{}")
  formattedProblem         String             @db.Text
  imageData                Bytes?
  imageMimeType            String?
  imagePrompt              String?            @db.Text
  canBeExplainedByDiagrams Boolean            @default(false)
  storyPart                String?            @db.Text
  coreIdea                 String?            @db.Text
  sourceDescription        String             @db.Text
  generationMode           String             @default("single")
  batchId                  String?
  rawOutput                Json
  // Hidden-test judging: the reference solution computes every expected output,
  // and an independent brute-force solution cross-checks it on small inputs.
  referenceSolution        String?            @db.Text
  bruteForceSolution       String?            @db.Text
  validationStatus         String             @default("unvalidated")
  validationError          String?            @db.Text
  createdById              String?
  publishedAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  createdBy User?                 @relation("ArenaProblemAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  // batchId is the id of the contest (6-problem set) this problem belongs to.
  contest   ArenaContest?         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  attempts  ArenaProblemAttempt[]
  testCases ArenaTestCase[]

  @@index([status, xp])
  @@index([batchId])
}

// One row per student per problem: the single source of truth for hint usage
// and the XP the student actually earned (after the hint penalty).
model ArenaProblemAttempt {
  id              String    @id @default(uuid())
  userId          String
  problemId       String
  hintUsed        Boolean   @default(false)
  hintUsedAt      DateTime?
  solved          Boolean   @default(false)
  solvedAt        DateTime?
  earnedXp        Float     @default(0)
  submissionCount Int       @default(0)
  // Rejected submissions before the problem was solved (leaderboard tie-break).
  failedCount     Int       @default(0)
  lastVerdict     String?
  lastLanguage    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem ArenaProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([problemId])
}

enum ArenaContestStatus {
  CURRENT
  ARCHIVED
}

// One Sunday Arena contest = one generated 6-problem set. The live window
// (startsAt..endsAt) is enforced by the server; when a newer contest is
// generated the previous one is ARCHIVED (kept with its standings and medals).
model ArenaContest {
  id          String             @id @default(uuid())
  edition     Int                @unique @default(autoincrement())
  title       String
  story       String             @db.Text
  status      ArenaContestStatus @default(CURRENT)
  startsAt    DateTime?
  endsAt      DateTime?
  finalizedAt DateTime?
  archivedAt  DateTime?
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  createdBy     User?               @relation("ArenaContestAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  problems      ArenaProblem[]
  registrations ArenaRegistration[]
  medals        ArenaMedal[]

  @@index([status])
}

model ArenaRegistration {
  id           String   @id @default(uuid())
  contestId    String
  userId       String
  registeredAt DateTime @default(now())

  contest ArenaContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([userId])
}

// Awarded by the server to the top 3 of a contest once it ends.
model ArenaMedal {
  id              String   @id @default(uuid())
  contestId       String
  userId          String
  rank            Int
  medalType       String
  score           Float
  maxScore        Float
  solvedCount     Int
  participants    Int
  bonusXp         Int
  certificateCode String   @unique
  awardedAt       DateTime @default(now())

  contest ArenaContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([userId])
}

// Hidden tests of an arena problem. Never sent to students: submissions are
// executed against every input and compared with expectedOutput.
model ArenaTestCase {
  id             String   @id @default(uuid())
  problemId      String
  order          Int
  // "edge" = small hand-picked case, "large" = generated stress case
  kind           String   @default("edge")
  input          String   @db.Text
  expectedOutput String   @db.Text
  createdAt      DateTime @default(now())

  problem ArenaProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId, order])
}

/// A student asks to join an organization (a User with role PARENT) by entering its code.
/// Accepting sets the student's parentId to the organization.
model OrganizationJoinRequest {
  id             String                 @id @default(uuid())
  studentId      String
  organizationId String
  status         OrganizationJoinStatus @default(PENDING)
  createdAt      DateTime               @default(now())
  decidedAt      DateTime?
  student        User                   @relation("JoinRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  organization   User                   @relation("JoinRequestOrganization", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([studentId, createdAt])
}
